datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  PROJECT_MANAGER
  MEMBER
  VIEWER
}

enum MilestoneStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

enum DependencyType {
  BLOCKS
  BLOCKED_BY
  RELATES_TO
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskCategory {
  CORE_PROJECT
  RD
  OPERATIONS
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_STATUS_CHANGED
  COMMENT_ADDED
  PROJECT_INVITATION
  KPI_GENERATED
  SYSTEM
}

model Department {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  users       User[]
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  name            String
  password        String?
  role            Role            @default(EMPLOYEE)
  isActive        Boolean         @default(true)
  googleId        String?         @unique
  avatar          String?
  departmentId    String?
  department      Department?     @relation(fields: [departmentId], references: [id])
  createdProjects Project[]       @relation("ProjectCreator")
  projectMembers  ProjectMember[]
  assignedTasks   Task[]          @relation("TaskAssignee")
  createdTasks    Task[]          @relation("TaskCreator")
  comments        Comment[]
  uploadedFiles   TaskAttachment[] @relation("AttachmentUploader")
  kpiLogs         KpiLog[]
  workLogs        WorkLog[]
  payrollRecords  PayrollRecord[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  reviewedTasks   Task[]          @relation("TaskReviewer")
  completedChecklists TaskChecklist[] @relation("ChecklistCompletedBy")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Project {
  id           String          @id @default(uuid())
  name         String
  description  String?
  status       ProjectStatus   @default(PLANNING)
  startDate    DateTime?
  endDate      DateTime?
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id])
  createdById  String
  creator      User            @relation("ProjectCreator", fields: [createdById], references: [id])
  members      ProjectMember[]
  tasks        Task[]
  milestones   Milestone[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())

  @@unique([projectId, userId])
}

model Task {
  id              String          @id @default(uuid())
  title           String
  description     String?
  status          TaskStatus      @default(TODO)
  category        TaskCategory    @default(CORE_PROJECT)
  priority        TaskPriority    @default(MEDIUM)
  dueDate         DateTime?
  completedAt     DateTime?
  position        Int             @default(0)
  estimatedHours  Float?
  actualHours     Float?
  kpiBonusScore   Float?          @default(0)
  kpiPenaltyScore Float?          @default(0)
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId      String?
  assignee        User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById     String
  creator         User            @relation("TaskCreator", fields: [createdById], references: [id])
  subTasks        SubTask[]
  comments        Comment[]
  attachments     TaskAttachment[]
  workLogs        WorkLog[]
  reviewerId      String?
  reviewer        User?           @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  milestoneId     String?
  milestone       Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  rejectReason    String?         @db.Text
  dependencies    TaskDependency[] @relation("TaskDependencies")
  dependedBy      TaskDependency[] @relation("TaskDependedBy")
  checklists      TaskChecklist[]

  // Tự liên kết (Self-relation) để tạo cấu trúc cây Công việc lớn - Công việc con (WBS)
  parentId        String?
  parentTask      Task?           @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks        Task[]          @relation("TaskSubtasks")
  isParent        Boolean         @default(false)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([parentId])
  @@index([reviewerId])
  @@index([milestoneId])
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?         @db.Text
  startDate   DateTime?
  dueDate     DateTime?
  status      MilestoneStatus @default(PLANNING)
  tasks       Task[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
}

model TaskDependency {
  id              String         @id @default(uuid())
  taskId          String
  task            Task           @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  dependsOnTask   Task           @relation("TaskDependedBy", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  type            DependencyType @default(BLOCKS)
  createdAt       DateTime       @default(now())

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
}

model TaskChecklist {
  id            String    @id @default(uuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  content       String    @db.Text
  isRequired    Boolean   @default(true)
  isCompleted   Boolean   @default(false)
  completedById String?
  completedBy   User?     @relation("ChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([taskId])
  @@index([completedById])
}

model TaskAttachment {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  fileType    String
  fileSize    Int
  uploadedById String?
  uploader    User?    @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
  @@index([uploadedById])
}

model SubTask {
  id          String   @id @default(uuid())
  title       String
  isCompleted Boolean  @default(false)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KpiLog {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period         String // e.g. "2026-10"
  tasksCompleted Int      @default(0)
  tasksOnTime    Int      @default(0)
  totalScore     Float    @default(0)
  rank           String   @default("C")
  details        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, period])
}

model OneTimeCode {
  id        String             @id @default(uuid())
  email     String
  purpose   String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime           @default(now())

  @@unique([email, purpose])
  @@index([expiresAt])
  @@map("one_time_codes")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  isRead    Boolean          @default(false)
  relatedId String?
  createdAt DateTime         @default(now())
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  entityType  String
  entityId    String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
}

model WorkLog {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hours       Float
  description String?  @db.Text
  loggedDate  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
}

model PayrollPeriod {
  id                         String          @id @default(uuid())
  period                     String          @unique // e.g. "2026-11"
  status                     String          @default("DRAFT") // "DRAFT" | "LOCKED"
  isLocked                   Boolean         @default(false)
  totalStaff                 Int             @default(0)
  totalConfirmedStaff        Int             @default(0)
  totalPendingStaff          Int             @default(0)
  totalCompanyConvertedHours Float           @default(0)
  totalCompanyPayroll        Float           @default(0)
  avgCompletionPercent       Float           @default(0)
  lockedAt                   DateTime?
  lockedBy                   String?
  snapshot                   Json?
  records                    PayrollRecord[]
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
}

model PayrollRecord {
  id                    String         @id @default(uuid())
  periodId              String?
  periodRef             PayrollPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)
  period                String         // e.g. "2026-11"
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                String         @default("PENDING") // "PENDING" | "CONFIRMED" | "LOCKED"
  managementHours       Float          @default(0)
  projectHours          Float          @default(0)
  projectConvertedHours Float          @default(0)
  rdHours               Float          @default(0)
  rdCappedHours         Float          @default(0)
  rdExceededHours       Float          @default(0)
  totalConvertedHours   Float          @default(0)
  standardHourRate      Float          @default(100000)
  projectHourRate       Float          @default(180000)
  projectScaleFactor    Float          @default(1.2)
  seniorityLevel        String         @default("MIDDLE")
  seniorityFactor       Float          @default(0.2)
  managementSalary      Float          @default(0)
  seniorityAllowance    Float          @default(0)
  rdSalary              Float          @default(0)
  projectSalary         Float          @default(0)
  totalSalary           Float          @default(0)
  monthlySalaryEstimate Float          @default(0)
  formulaDescription    String?        @db.Text
  confirmedAt           DateTime?
  confirmedBy           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([userId, period])
  @@index([period])
}
